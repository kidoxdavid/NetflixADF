# Copy to .env and edit. Real environment variables override this file.
PORT=3000
HOST=127.0.0.1                 # use 0.0.0.0 only behind a TLS reverse proxy / container
DATABASE_FILE=data/ledgerflow.db
BACKUP_DIR=data/backups
PUBLIC_URL=http://localhost:3000   # base URL used when building secure client links
COOKIE_SECURE=false            # set true when served over HTTPS
TRUST_PROXY=                   # set to 1 when behind a reverse proxy (so client IPs / https are detected)
ALLOW_REGISTRATION=false       # first account can always register; keep false afterwards
SCHEDULER=on                   # in-process hourly job for recurring invoices + reminders ("off" if you use cron + npm run jobs)

# Optional outgoing email (any SMTP provider). Leave SMTP_HOST empty to run without email:
# documents are then downloaded / copied, and messages are only ever "prepared", never "sent".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false              # true for port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Studio <billing@example.com>"

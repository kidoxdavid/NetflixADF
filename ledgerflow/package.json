{
  "name": "ledgerflow",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hostable rate-card-driven quoting, invoicing and small-business finance app",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "jobs": "tsx server/src/cli.ts jobs",
    "backup": "tsx server/src/cli.ts backup",
    "restore": "tsx server/src/cli.ts restore",
    "verify-backup": "tsx server/src/cli.ts verify-backup",
    "seed:demo": "tsx scripts/demo-seed.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}

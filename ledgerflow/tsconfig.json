{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "jsx": "react-jsx",
    "esModuleInterop": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"]
  },
  "include": ["server/src", "tests", "web/src"]
}
